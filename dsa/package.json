{
  "name": "dsa-ts",
  "version": "0.0.1",
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --verbose",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --verbose --coverage --testMatch '**/*.spec.ts'",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --verbose --coverage --testMatch '**/*.test.ts'",
    "test:all": "npm run test:unit && npm run test:integration",
    "build": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' tsc"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@jest/globals": "^30.0.0-beta.3",
    "@types/jest": "^29.5.14",
    "babel-jest": "^30.0.0-beta.3",
    "jest": "^29.7.0",
    "mock-stdin": "^1.0.0",
    "typescript": "^5.8.3"
  }
}
