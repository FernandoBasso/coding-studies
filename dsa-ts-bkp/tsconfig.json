{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "target": "es2022",
    // https://www.typescriptlang.org/docs/handbook/modules/theory.html
    "module": "nodenext",
    "strict": true,
    "checkJs": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "./**/*.ts"
  ]
  // "exclude": ["./src/*.spec.ts"]
}
